#!/usr/bin/env bash
# git credential helper: answers `get` with the token from the Secret mounted at /secrets/git,
# but only for the Secret's host (key `host`, default github.com), so the token never goes elsewhere.
set -euo pipefail
dir=/secrets/git
[[ "${1:-}" == get ]] || exit 0
declare -A req
while IFS='=' read -r k v; do [[ -n "$k" ]] && req[$k]=$v; done
want=github.com
[[ -f "$dir/host" ]] && want=$(<"$dir/host")
[[ "${req[protocol]:-}" == https && "${req[host]:-}" == "$want" ]] || exit 0
user=x-access-token
[[ -f "$dir/username" ]] && user=$(<"$dir/username")
printf 'username=%s\npassword=%s\n' "$user" "$(<"$dir/token")"
